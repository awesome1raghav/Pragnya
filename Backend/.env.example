# Copy to Backend/.env (ignored by Git). Names only here; never commit real values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Must match Infrastructure/Docker/.env (user, password, port, database).
DATABASE_URL=postgresql+psycopg://nextron:change-me@127.0.0.1:5433/nextron
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Comma-separated browser origins allowed to call the API (the web frontend runs on 8080).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Evidence storage root (default Backend/Storage, ignored by Git) and upload limit (bytes).
# STORAGE_ROOT=C:/NEXTRON-Evidence
MAX_UPLOAD_SIZE_BYTES=524288000

# FFprobe for media validation and metadata: a name on PATH or an absolute path.
FFPROBE_PATH=ffprobe
# Chromaprint for NEX-AUD acoustic fingerprints (optional; its absence is reported, not hidden).
# FPCALC_PATH=fpcalc
MEDIA_PROBE_TIMEOUT_SECONDS=30

# T-MIR, jobs and workers (defaults shown). Uploads queue an analysis run; a worker process executes it.
# AUTO_ANALYZE_ON_UPLOAD=true
# A worker that stops renewing its lease for JOB_LEASE_SECONDS is presumed dead and its job is recovered.
# JOB_LEASE_SECONDS=30
# JOB_HEARTBEAT_SECONDS=5
# JOB_MAX_ATTEMPTS=3
# Retry backoff = JOB_RETRY_BASE_SECONDS x 2^(attempt-1).
# JOB_RETRY_BASE_SECONDS=5
# JOB_TIMEOUT_SECONDS=1800
# MODULE_TIMEOUT_SECONDS=600
# WORKER_POLL_SECONDS=1
# How often each API process delivers new events to WebSocket clients and notifications.
# OUTBOX_POLL_SECONDS=0.5

# Neo4j graph projection (Step 7): a rebuildable copy of each case's latest evidence graph, kept current by the
# worker. Leave NEO4J_URI empty to disable it. The password must match Infrastructure/Docker/.env.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me-neo4j

# Search images already preserved in each investigation. Model installer: python -m Scripts.Maintenance.InstallVisualModel
# QDRANT_URL=http://127.0.0.1:6333
# VISUAL_SEARCH_MAX_BYTES=10485760
# Public web search remains disabled unless separately configured and approved.
# SERPAPI_API_KEY=your-serpapi-free-plan-key
# WEB_VISUAL_SEARCH_ENABLED=true

# Pretrained detectors, run in a separate process (Documentation/Testing/Detector Benchmark.md).
# Weights are pinned files under Backend/Models; an empty name turns one off.
# DETECTORS_ENABLED=true
# IMAGE_DETECTOR=CommunityForensics
# SPEECH_DETECTOR=SSL-AASIST-DF
# DETECTOR_TIMEOUT_SECONDS=120

# Backups (Scripts/Database/BackupDatabase.py): always AES-256-GCM encrypted. Generate a key with
#   .\.venv\Scripts\python.exe -m Scripts.Database.BackupDatabase --new-key
# and keep a copy outside this machine: without it the backups cannot be restored.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_DIR=Backups
# PG_TOOLS=docker:nextron-postgres   (or "local" to use pg_dump/pg_restore from PATH)
# Hardening: state-changing requests per client per minute (0 disables)
# RATE_LIMIT_MUTATIONS_PER_MINUTE=600
