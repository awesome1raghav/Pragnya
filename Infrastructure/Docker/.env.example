# Copy to Infrastructure/Docker/.env (ignored by Git) and set a real password.
# Backend/.env DATABASE_URL must use the same user, password, port and database.
POSTGRES_DB=nextron
POSTGRES_USER=nextron
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Neo4j: the graph projection (Step 7). Neo4j needs at least 8 characters.
NEO4J_PASSWORD=change-me-neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
